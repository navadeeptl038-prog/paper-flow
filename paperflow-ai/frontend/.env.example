# Frontend public environment variables — PaperFlow AI
#
# Copy this file to `.env` and fill in values for your environment.
# Never put secrets here (no service-role keys, Gemini keys, OAuth secrets).
#
# ── API ─────────────────────────────────────────────────────────────────────
# URL of the FastAPI backend. No trailing slash.
# Local development:   http://127.0.0.1:8000
# Production:          https://your-api.onrender.com
VITE_API_URL=

# ── Supabase (public / anon values only) ────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
