# Frontend public env only — never put secrets here.
# Copy this file to `.env` and fill values for your environment.
#
# Local development defaults (document only — leave values empty in this example):
#   VITE_API_URL=http://127.0.0.1:8000
# Production: set VITE_API_URL to your deployed HTTPS API origin (no trailing slash).

VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
