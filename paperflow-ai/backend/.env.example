# Backend env — names only. Copy to `.env` and fill locally.
# Never commit real secrets.
#
# Local development defaults (document only):
#   APP_NAME=PaperFlow AI
#   APP_VERSION=0.1.0
#   CORS_ORIGINS=http://localhost:5173
#   FRONTEND_URL=http://localhost:5173
#
# Production: set CORS_ORIGINS to your real frontend origin(s), comma-separated.
# Do not use "*" with credentials in production.

APP_NAME=
APP_VERSION=
CORS_ORIGINS=
FRONTEND_URL=
CORS_ALLOW_METHODS=
CORS_ALLOW_HEADERS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
