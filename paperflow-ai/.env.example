# =============================================================================
# PAPERFLOW AI — environment variable names only (no real secrets)
# Copy to .env and fill values locally. Never commit real .env files.
# Frontend-safe vars must remain public/anon only; secrets stay backend-only.
# =============================================================================

# --- App ---
APP_NAME=
APP_ENV=
FRONTEND_URL=
BACKEND_URL=
CORS_ORIGINS=

# --- Frontend (Vite / React) — public values only ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# --- Supabase (backend) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=

# --- Database ---
DATABASE_URL=

# --- Gemini (backend only) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Embeddings ---
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# --- Google OAuth (login — separate from Drive/Gmail connectors) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Google Drive connector (backend) ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_SCOPES=

# --- Gmail connector (backend) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_SCOPES=

# --- Auth / session ---
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# --- Uploads / processing ---
MAX_UPLOAD_SIZE_MB=
ALLOWED_FILE_EXTENSIONS=
TEMP_PROCESSING_DIR=

# --- OCR ---
TESSERACT_CMD=

# --- Render / deployment ---
RENDER_EXTERNAL_URL=
PORT=
